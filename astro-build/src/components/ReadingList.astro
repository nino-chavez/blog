---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentId?: string;
}

const { posts, currentId } = Astro.props;
const PAGE_SIZE = 12;
const currentIndex = posts.findIndex((post) => post.id === currentId);
const initialPage = currentIndex >= 0 ? Math.floor(currentIndex / PAGE_SIZE) + 1 : 1;
const formatDate = (date: Date | string) => new Date(date).toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
const pageCount = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<details class="reading-list" id="choose-another-post" data-current-id={currentId} open>
  <summary>
    <span>Choose another post</span>
    <small>{posts.length} titles · search and archive pages</small>
  </summary>
  <div class="reading-list__panel">
    <div class="reading-list__heading">
      <h2>All posts</h2>
      <span data-reading-count>{posts.length} posts</span>
    </div>
    <form class="reading-list__search" action="/blog/archive" method="get">
      <label for="reading-list-query">Search titles, descriptions, and tags</label>
      <div>
        <input id="reading-list-query" name="q" type="search" autocomplete="off" />
        <button type="submit">Search</button>
      </div>
      <p data-reading-filter hidden></p>
    </form>
    <ol data-reading-rows>
      {posts.map((post, index) => (
        <li
          data-reading-row
          data-slug={post.id}
          id={`post-${post.id}`}
          data-title={post.data.title.toLowerCase()}
          data-description={(post.data.excerpt || '').toLowerCase()}
          data-tags={(post.data.tags || []).join(' ').toLowerCase()}
          data-index={index}
          class:list={{ 'is-current': post.id === currentId }}
        >
          <time datetime={new Date(post.data.publishedAt).toISOString()}>{formatDate(post.data.publishedAt)}</time>
          <a
            href={`/blog/${post.id}?from=${encodeURIComponent(post.id)}&page=${Math.floor(index / PAGE_SIZE) + 1}`}
            aria-current={post.id === currentId ? 'page' : undefined}
            data-reading-link
            data-slug={post.id}
          >{post.data.title}</a>
          {post.id === currentId && <span class="reading-list__current">Reading now</span>}
        </li>
      ))}
    </ol>
    <p class="reading-list__empty" data-reading-empty hidden>No posts match this search. <a href="/blog/archive#choose-another-post">Show all posts</a>.</p>
    <nav class="reading-list__pages" aria-label="Archive pages" data-reading-pages>
      <a href={`/blog/archive?page=${Math.max(1, initialPage - 1)}#choose-another-post`} data-reading-previous hidden={initialPage <= 1}>← Previous page</a>
      <span data-reading-page-status>Page {initialPage} of {pageCount}</span>
      <a href={`/blog/archive?page=${Math.min(initialPage + 1, pageCount)}#choose-another-post`} data-reading-next hidden={initialPage >= pageCount}>Next page →</a>
    </nav>
    <p class="reading-list__utility"><button type="button" data-search-trigger>Search all writing</button></p>
  </div>
</details>

<noscript>
  <p>All posts are available in the list. Use your browser’s Find command to search their titles.</p>
  <style is:inline>.reading-list__search, .reading-list__pages, .reading-list__utility { display: none; }</style>
</noscript>

<script>
  import '../scripts/reading-list';
</script>
