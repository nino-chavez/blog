---
import SearchModal from './SearchModal.astro';

interface Props {
  currentPage?: 'blog' | 'series' | 'tags' | 'whitepapers' | 'presentations' | 'tutorials' | 'fiction' | 'counterpoints' | 'research' | 'about';
  variant?: 'article';
}

const { currentPage } = Astro.props;
const primary = [
  { href: '/blog/archive', label: 'All posts', id: 'blog' },
  { href: '/blog/series', label: 'Series', id: 'series' },
  { href: '/blog/fiction', label: 'Fiction', id: 'fiction' },
];
const more = [
  { href: '/blog/whitepapers', label: 'Whitepapers', id: 'whitepapers' },
  { href: '/blog/presentations', label: 'Presentations', id: 'presentations' },
  { href: '/blog/tutorials', label: 'Tutorials', id: 'tutorials' },
  { href: '/blog/counterpoints', label: 'Counterpoints', id: 'counterpoints' },
  { href: '/blog/tags', label: 'Tags', id: 'tags' },
];
---

<header class="signal-dispatch-header">
  <nav class="signal-dispatch-header__inner" aria-label="Signal Dispatch">
    <a href="/blog" class="signal-dispatch-header__name" aria-current={currentPage === 'blog' ? 'page' : undefined}>Signal Dispatch</a>
    <div class="signal-dispatch-header__links">
      {primary.map((link) => <a href={link.href} aria-current={currentPage === link.id ? 'page' : undefined}>{link.label}</a>)}
      <details>
        <summary>More writing</summary>
        <div class="signal-dispatch-header__more">
          {more.map((link) => <a href={link.href} aria-current={currentPage === link.id ? 'page' : undefined}>{link.label}</a>)}
        </div>
      </details>
      <button type="button" data-search-trigger>Search all writing</button>
      <a href="/blog/rss.xml">RSS</a>
    </div>
  </nav>
</header>

<SearchModal />

<style>
  .signal-dispatch-header { border-bottom: 1px solid rgb(18 42 60 / .24); background: #f4f0e8; color: #122a3c; }
  .signal-dispatch-header__inner { width: min(1360px, calc(100% - 64px)); min-height: 72px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .signal-dispatch-header a, .signal-dispatch-header button, .signal-dispatch-header summary { color: #122a3c; font: 600 .78rem/1.4 'Inter Variable', Inter, system-ui, sans-serif; text-decoration: none; }
  .signal-dispatch-header__name { font-family: Georgia, 'Times New Roman', serif !important; font-size: 1.3rem !important; font-weight: 700 !important; letter-spacing: -.03em; }
  .signal-dispatch-header__links { display: flex; align-items: center; gap: 1.15rem; }
  .signal-dispatch-header__links > a, .signal-dispatch-header button, .signal-dispatch-header summary { min-height: 44px; display: inline-flex; align-items: center; cursor: pointer; }
  .signal-dispatch-header button { padding: 0; border: 0; background: transparent; }
  .signal-dispatch-header a:hover, .signal-dispatch-header button:hover, .signal-dispatch-header summary:hover { color: #0d5a93; }
  .signal-dispatch-header a[aria-current] { text-decoration: underline; text-underline-offset: .28em; }
  .signal-dispatch-header details { position: relative; }
  .signal-dispatch-header summary { list-style: none; }
  .signal-dispatch-header summary::-webkit-details-marker { display: none; }
  .signal-dispatch-header__more { position: absolute; z-index: 10; right: 0; top: calc(100% - 4px); width: 160px; padding: .45rem; border: 1px solid rgb(18 42 60 / .24); background: #fbf8f1; box-shadow: 0 8px 18px rgb(18 42 60 / .12); }
  .signal-dispatch-header__more a { display: block; padding: .55rem .65rem; }
  .signal-dispatch-header :focus-visible { outline: 2px solid #0d5a93; outline-offset: 3px; }
  @media (max-width: 760px) { .signal-dispatch-header__inner { width: min(100% - 32px, 600px); min-height: 58px; } .signal-dispatch-header__links { gap: .75rem; } .signal-dispatch-header__links > a:not(:last-child), .signal-dispatch-header details { display: none; } .signal-dispatch-header__links button { font-size: .72rem; } .signal-dispatch-header__name { font-size: 1.13rem !important; } }
</style>
