---
const primary = [
  ['Work', '/work'],
  ['Sessions', '/demos'],
  ['Learn', '/learn'],
  ['Writing', '/blog'],
  ['Photography', '/photography'],
  ['About', '/about'],
];

const secondary = [
  ['Now', '/now'],
  ['Links', '/links'],
  ['Privacy', '/privacy'],
];
---

<footer class="practice-footer">
  <div class="practice-footer__inner">
    <div>
      <p class="practice-footer__name">Nino Chavez</p>
      <p>Product architect and builder in Chicago.</p>
    </div>

    <nav aria-label="Site navigation">
      {primary.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <nav aria-label="More pages">
      {secondary.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <nav aria-label="External profiles">
      <a href="https://github.com/nino-chavez">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/nino-chavez/">LinkedIn ↗</a>
      <a href="mailto:nino@ninochavez.co">Email ↗</a>
    </nav>
  </div>

  <div class="publication-footer">
    <p>Signal Dispatch</p>
    <nav aria-label="Signal Dispatch feeds and machine-readable formats">
      <a href="/blog/rss.xml">RSS Feed</a>
      <a href="/blog/full-content-rss.xml">Full RSS</a>
      <a href="/blog/api/posts.json">API</a>
      <a href="/blog/llms.txt">llms.txt</a>
    </nav>
    <small>&copy; {new Date().getFullYear()} Nino Chavez.</small>
  </div>
</footer>

<style>
  /* Shell chrome values are a machine copy of the parent site's contract —
     website-nc docs/claude-design-system.md (2026-08-04). See SiteHeader.astro
     for the token table; the two shell components change together. */
  .practice-footer {
    margin-top: 32px;
    border-top: 1px solid #b9bec6;
    background: #f0f1f4;
    color: #14202e;
  }
  .practice-footer__inner {
    display: grid;
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto;
    padding: 54px 0 48px;
    grid-template-columns: minmax(240px, 1.35fr) repeat(3, minmax(120px, 0.55fr));
    gap: 40px;
  }
  .practice-footer p {
    margin: 0;
    color: #5a6472;
    font-size: 0.9rem;
  }
  .practice-footer .practice-footer__name {
    margin-bottom: 6px;
    color: #14202e;
    font-size: 1.05rem;
    font-weight: 760;
  }
  .practice-footer nav {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .practice-footer a {
    color: #5a6472;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .practice-footer a:hover,
  .practice-footer a:focus-visible {
    color: #14202e;
  }
  .practice-footer :focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #f0f1f4,
      0 0 0 4px #14679e;
  }
  .publication-footer {
    display: grid;
    width: min(1320px, calc(100% - 48px));
    min-height: 68px;
    margin: 0 auto;
    padding: 16px 0;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 28px;
    border-top: 1px solid #b9bec6;
  }
  /* On the shell's bone ground the publication credit runs ink — coral at
     0.9rem on #f0f1f4 reads 2.7:1 and fails contrast. Coral stays the
     publication's accent inside the article surface, where its ground is
     its own (DESIGN.md). */
  .publication-footer p {
    color: #14202e;
    font-weight: 760;
  }
  .publication-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
  }
  .publication-footer small {
    color: #5a6472;
  }

  @media (max-width: 800px) {
    .practice-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .practice-footer__inner > div {
      grid-column: 1 / -1;
    }
    .publication-footer {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 520px) {
    .practice-footer__inner,
    .publication-footer {
      width: calc(100% - 32px);
    }
    .practice-footer__inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .practice-footer__inner > div {
      grid-column: auto;
    }
  }
</style>
