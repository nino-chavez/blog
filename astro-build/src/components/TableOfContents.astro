---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  minHeadings?: number;
  variant?: 'article';
}

const { headings, minHeadings = 3, variant } = Astro.props;

// Filter to H2 and H3 only (skip H1)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Don't render if not enough headings
const shouldRender = tocHeadings.length >= minHeadings;
---

{shouldRender && (
  <nav class:list={[
    'toc-wrapper',
    'no-print',
    variant === 'article'
      ? 'article-toc'
      : 'rounded-xl border border-zinc-700/50 bg-zinc-900/50 p-5 mb-8',
  ]} aria-label="On this page">
    <details class:list={['group', variant === 'article' && 'article-toc__details']} open>
      <summary class="flex items-center justify-between cursor-pointer list-none">
        <h2 class:list={[
          'text-sm font-semibold flex items-center gap-2',
          variant === 'article' ? 'article-toc__title' : 'text-zinc-400 uppercase tracking-wider',
        ]}>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          Table of Contents
        </h2>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class:list={['w-4 h-4 transition-transform duration-200 group-open:rotate-180', variant === 'article' ? 'article-toc__icon' : 'text-zinc-500']}
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <ul class:list={['mt-4 space-y-2', variant === 'article' && 'article-toc__list']}>
        {tocHeadings.map((heading) => (
          <li class={heading.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${heading.slug}`}
              class={variant === 'article'
                ? `article-toc__link ${heading.depth === 2 ? 'article-toc__link--primary' : 'article-toc__link--secondary'}`
                : `block text-sm transition-colors duration-150 hover:text-signal-coral ${heading.depth === 2 ? 'text-zinc-300 font-medium' : 'text-zinc-500'}`}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style>
  /* Remove default summary arrow in WebKit browsers */
  details summary::-webkit-details-marker {
    display: none;
  }

  /* Smooth scroll behavior for jump links */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* Offset for sticky header when jumping to anchors */
  :global([id]) {
    scroll-margin-top: 6rem;
  }
</style>

{variant === 'article' && (
  <script>
    const articleTocDetails = document.querySelector<HTMLDetailsElement>('.article-toc__details');
    const compactToc = window.matchMedia('(max-width: 640px)');
    const setTocState = () => {
      if (!articleTocDetails) return;
      articleTocDetails.open = !compactToc.matches;
    };
    setTocState();
    compactToc.addEventListener('change', setTocState);
  </script>
)}
