---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SubjectNav from '../../components/SubjectNav.astro';
import { generateBlogSchema, generatePersonSchema, generateWebsiteSchema } from '../../utils/schema';
import { featureImageSrcset } from '../../utils/feature-image';
import '../../styles/article.css';
import '../../styles/reading-list.css';
export const prerender = true;
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).filter(post => post.id !== 'archive').sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const latest = posts[0];
const recent = posts.slice(1, 5);
const date = (post: typeof latest) => new Date(post.data.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const readingTime = (post: typeof latest) => Math.max(1, Math.ceil((post.body?.split(/\s+/).length || 0) / 200));
---
<BaseLayout title="Signal Dispatch" description="Essays, fiction, tutorials, and research on architecture, commerce, and AI-assisted work." jsonLd={[generateWebsiteSchema(), generateBlogSchema(posts), generatePersonSchema()]} theme="article">
  <a class="skip-publication" href="#main">Skip to content</a>
  <SiteHeader currentPage="blog" variant="article" />
  <main id="main" class="journal-home" tabindex="-1">
    <div class="journal-intro"><h1>Essays by Nino Chavez</h1><p>On building with AI, leading teams, and learning through the work.</p></div>
    {latest && <section aria-label="Latest essay"><a class="journal-lead" href={`/blog/${latest.id}`}>
      <div class="journal-lead__copy"><div class="essay-meta"><span class="latest-label">Latest essay</span><time datetime={new Date(latest.data.publishedAt).toISOString()}>{date(latest)}</time></div><h2>{latest.data.title}</h2><p>{latest.data.excerpt}</p><span class="read-essay">Read essay <span aria-hidden="true">→</span></span></div>
      {latest.data.featureImage && <img src={latest.data.featureImage} srcset={featureImageSrcset(latest.data.featureImage)} sizes="(max-width: 760px) calc(100vw - 44px), 540px" width="1200" height="675" alt="" fetchpriority="high" decoding="async" />}
    </a></section>}
    <div class="journal-discovery">
      <aside><SubjectNav /></aside>
      <section aria-labelledby="more-to-read"><div class="journal-section-heading"><h2 id="more-to-read">More to read</h2><a href="/blog/archive">All essays</a></div>
        <div class="journal-grid">{recent.map(post => <article class="journal-card"><a href={`/blog/${post.id}`}>
          {post.data.featureImage && <img src={post.data.featureImage} srcset={featureImageSrcset(post.data.featureImage)} sizes="(max-width: 760px) calc(100vw - 44px), 460px" width="1200" height="675" alt="" loading="lazy" decoding="async" />}
          <div class="essay-meta"><time datetime={new Date(post.data.publishedAt).toISOString()}>{date(post)}</time><span>{readingTime(post)} min read</span></div>
          <h3>{post.data.title}</h3><p>{post.data.excerpt}</p>
        </a></article>)}</div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
