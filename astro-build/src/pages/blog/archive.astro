---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SubjectNav from '../../components/SubjectNav.astro';
import ReadingList from '../../components/ReadingList.astro';
import { generateBlogSchema, generateWebsiteSchema } from '../../utils/schema';
import '../../styles/article.css';
import '../../styles/reading-list.css';
export const prerender = true;
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).filter(post => post.id !== 'archive').sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---
<BaseLayout title="All essays — Signal Dispatch" description="Browse recent essays, explore a subject, or find a post you remember." jsonLd={[generateWebsiteSchema(), generateBlogSchema(posts)]} theme="article">
  <a class="skip-publication" href="#main">Skip to content</a>
  <SiteHeader currentPage="blog" variant="article" />
  <main id="main" class="essay-archive" tabindex="-1">
    <header class="archive-opening"><h1>All essays</h1><p>Browse the writing, or find a post you remember.</p></header>
    <div class="archive-layout"><aside><SubjectNav all /></aside><ReadingList posts={posts} /></div>
  </main>
  <SiteFooter />
</BaseLayout>
