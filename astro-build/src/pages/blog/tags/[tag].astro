---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SubjectNav from '../../../components/SubjectNav.astro';
import ReadingList from '../../../components/ReadingList.astro';
import { CANONICAL_TAGS, type CanonicalTag } from '../../../config/tags';
import { generateCollectionSchema } from '../../../utils/schema';
import '../../../styles/article.css';
import '../../../styles/reading-list.css';
export const prerender = true;
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status === 'published');
  return [...new Set(posts.filter(post => post.id !== 'archive').flatMap(post => post.data.tags || []))].map(tag => ({ params: { tag } }));
}
const tag = Astro.params.tag!;
const meta = CANONICAL_TAGS[tag as CanonicalTag];
const label = meta?.label || tag;
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).filter(post => post.id !== 'archive').sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const selected = posts.filter(post => post.data.tags?.includes(tag));
const description = `Signal Dispatch essays about ${label.toLowerCase()}.`;
const schema = generateCollectionSchema(label, description, `https://ninochavez.co/blog/tags/${encodeURIComponent(tag)}`, selected);
---
<BaseLayout title={`${label} — Signal Dispatch`} description={description} jsonLd={[schema]} theme="article">
  <a class="skip-publication" href="#main">Skip to content</a>
  <SiteHeader currentPage="tags" variant="article" />
  <main id="main" class="essay-archive" tabindex="-1">
    <header class="archive-opening"><h1>{label}</h1><p>{meta?.description || 'Explore the writing in this subject.'}</p></header>
    <div class="archive-layout"><aside><SubjectNav active={tag} all /></aside><ReadingList posts={posts} subject={tag} /></div>
  </main>
  <SiteFooter />
</BaseLayout>
