---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { CANONICAL_TAGS, type CanonicalTag } from '../../../config/tags';
import { generateCollectionSchema } from '../../../utils/schema';
import '../../../styles/article.css';
import '../../../styles/reading-list.css';
export const prerender = true;
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).filter(post => post.id !== 'archive');
const counts = new Map<string, number>();
posts.forEach(post => post.data.tags?.forEach(tag => counts.set(tag, (counts.get(tag) || 0) + 1)));
const subjects = Object.entries(CANONICAL_TAGS).filter(([tag]) => counts.has(tag));
const other = [...counts.entries()].filter(([tag]) => !CANONICAL_TAGS[tag as CanonicalTag]).sort(([a], [b]) => a.localeCompare(b));
const schema = generateCollectionSchema('Signal Dispatch subjects', 'Explore the subjects covered in Signal Dispatch.', 'https://ninochavez.co/blog/tags', []);
---
<BaseLayout title="All subjects — Signal Dispatch" description="Explore the subjects covered in Signal Dispatch." jsonLd={[schema]} theme="article">
  <a class="skip-publication" href="#main">Skip to content</a>
  <SiteHeader currentPage="tags" variant="article" />
  <main id="main" class="essay-archive" tabindex="-1">
    <header class="archive-opening"><h1>All subjects</h1><p>Choose a subject to explore the essays.</p></header>
    <div class="subject-directory">{subjects.map(([tag, meta]) => <a href={`/blog/tags/${encodeURIComponent(tag)}`}><h2>{meta.label}</h2><p>{meta.description}</p><span>{counts.get(tag)} {counts.get(tag) === 1 ? 'essay' : 'essays'}</span></a>)}</div>
    {other.length > 0 && <section class="other-subjects" aria-labelledby="other-subjects-title"><h2 id="other-subjects-title">More from the archive</h2><div>{other.map(([tag, count]) => <a href={`/blog/tags/${encodeURIComponent(tag)}`}>{tag} <span>({count})</span></a>)}</div></section>}
  </main>
  <SiteFooter />
</BaseLayout>
